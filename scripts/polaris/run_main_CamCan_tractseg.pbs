./ExpRunner --fold 2 --data_path /grand/NeuroX/junbeom/TractSegVis --config CamCan_experiment_TractSeg --en CamCan_experiment_TractSeg_x5 --train True --test True --seg --num_processes 4 --rt --with_id TRAC-1143 &
wait


